{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-vercel.js",
  "outputDirectory": "cms-root-orchestration/dist",
  "rewrites": [
    { "source": "/auth/:path*", "destination": "/index.html" },
    { "source": "/editorial/:path*", "destination": "/index.html" },
    { "source": "/collab/:path*", "destination": "/index.html" },
    { "source": "/media/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/mfes/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}